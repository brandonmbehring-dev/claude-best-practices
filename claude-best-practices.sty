% claude-best-practices.sty
% Self-contained Tufte-style layout for the Claude Best Practices handbook.
% No external dependencies beyond standard TeX Live packages.
%
% Usage: \usepackage{claude-best-practices}
% Requires: LuaLaTeX with -shell-escape flag

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{claude-best-practices}[2026/02/25 Claude Best Practices Style v2.3]

% =============================================================================
% ENGINE DETECTION
% =============================================================================
\RequirePackage{iftex}
\RequireLuaTeX

% =============================================================================
% INDEX
% =============================================================================
\RequirePackage{makeidx}
\makeindex

% =============================================================================
% TUFTE-STYLE GEOMETRY
% =============================================================================
\RequirePackage{geometry}
\geometry{
    paperwidth=8.5in,
    paperheight=11in,
    left=1in,
    top=1in,
    textwidth=4.5in,
    marginparsep=0.3in,
    marginparwidth=1.9in,
    textheight=9in,
    footskip=0.5in,
    headheight=23pt
}

% Full-width length for tables spanning text + margin
\newlength{\fullwidthlen}
\AtBeginDocument{\setlength{\fullwidthlen}{\dimexpr\textwidth+\marginparwidth+\marginparsep\relax}}

% =============================================================================
% FONTS
% =============================================================================
\RequirePackage{fontspec}

% Fallback font for symbols (stars, arrows, etc.)
\directlua{
  luaotfload.add_fallback("symbolfallback", {
    "DejaVu Sans:mode=harf;",
  })
}

\setmainfont{Roboto}[
  UprightFont = *-Regular,
  BoldFont = *-Bold,
  ItalicFont = *-Italic,
  BoldItalicFont = *-BoldItalic,
  Scale = 1.0,
  RawFeature={fallback=symbolfallback}
]

\setmonofont{Source Code Pro}[
  Scale = 0.82,
  UprightFont = *-Regular,
  BoldFont = *-Bold,
  ItalicFont = *-It,
  BoldItalicFont = *-BoldIt
]

\setsansfont{Roboto}[
  UprightFont = *-Regular,
  BoldFont = *-Bold,
  ItalicFont = *-Italic,
  BoldItalicFont = *-BoldItalic
]

\newcommand{\marginfontsize}{\footnotesize}

% =============================================================================
% TYPOGRAPHY
% =============================================================================
\RequirePackage[
  protrusion=true,
  expansion=true,
  tracking=smallcaps,
  final
]{microtype}

\SetProtrusion{encoding=*,family=*}{
  1={-100,-100},
  .={0,500},
  ,={0,500}
}

\RequirePackage{setspace}
\setstretch{1.15}

% Tufte-style: indent, no parskip
\setlength{\parindent}{1em}
\setlength{\parskip}{0pt}

% Typesetting safety: extra stretch for difficult line breaks,
% minor overflow tolerance (2pt is imperceptible),
% suppress underfull warnings from narrow table columns and URL breaks
\emergencystretch=1em
\hfuzz=2pt
\hbadness=10000
\vfuzz=2pt

% =============================================================================
% COLORS — Warm Tol Hybrid palette (5-hue system)
% Tol Bright relationships + Anthropic warmth. Colorblind-safe.
% =============================================================================
\RequirePackage[dvipsnames,svgnames,x11names,table]{xcolor}

% --- Base palette (5 hues) ---
\definecolor{WarmBlue}{HTML}{3B6FA0}     % Structural: headings, links, info
\definecolor{WarmRose}{HTML}{C06858}     % Attention: warnings, alerts
\definecolor{WarmGreen}{HTML}{4A7E3F}    % Positive: tips, practitioner
\definecolor{WarmPlum}{HTML}{8A4E82}     % Authority: official, exercises
\definecolor{WarmGold}{HTML}{C09840}     % Insight: convergence, reasoning

% --- Warm neutrals (Anthropic-derived) ---
\definecolor{CodeBg}{HTML}{F7F5F0}
\definecolor{CodeFrame}{HTML}{B5B3AA}
\definecolor{DarkText}{HTML}{1A1A19}

% =============================================================================
% CODE LISTINGS (minted)
% =============================================================================
\RequirePackage{minted}

\setminted{
  frame=lines,
  framesep=1mm,
  bgcolor=CodeBg,
  rulecolor=CodeFrame,
  fontsize=\footnotesize,
  breaklines=true,
  breakanywhere=false,
  linenos=false,
  xleftmargin=0pt,
  baselinestretch=1.05,
  autogobble=true
}

\usemintedstyle{warmtol}

\RequirePackage{listings}
\lstset{
  basicstyle=\ttfamily\footnotesize,
  keywordstyle=\color{WarmBlue},
  commentstyle=\color{gray},
  stringstyle=\color{WarmRose},
  showstringspaces=false,
  breaklines=true,
  frame=single,
  numbers=none,
  tabsize=4,
  backgroundcolor=\color{CodeBg}
}

\RequirePackage[english]{babel}
\RequirePackage{csquotes}

% Inline code
\newcommand{\code}[1]{\texttt{#1}}

% =============================================================================
% MARGIN NOTES (Tufte-style)
% =============================================================================
\RequirePackage{changepage}
\RequirePackage{marginnote}

\let\pkgmarginnote\marginnote

% Flag: are we currently inside a margin note?
\newif\ifinmarginnote
\inmarginnotefalse

% Basic sidenote
\newcommand{\sidenote}[1]{%
  \pkgmarginnote{%
    \inmarginnotetrue
    \footnotesize\raggedright%
    \color{WarmBlue!70!black}%
    #1%
    \color{DarkText}%
    \inmarginnotefalse
    \vspace{2pt}%
  }%
}

% Full-width environment
\newenvironment{fullwidth}
  {\begin{adjustwidth}{}{-\dimexpr\marginparwidth+\marginparsep\relax}}
  {\end{adjustwidth}}

% =============================================================================
% CALLOUT BOXES (tcolorbox)
% =============================================================================
\RequirePackage[breakable,skins]{tcolorbox}

% --- MARGIN CALLOUT BOXES ---
\newtcolorbox{marginbox}[2][Note]{
  breakable=false,
  enhanced,
  colframe=#2,
  colback=#2!5,
  coltitle=DarkText,
  fonttitle=\bfseries\small,
  title=#1,
  leftrule=2pt,
  rightrule=0pt,
  toprule=0pt,
  bottomrule=0pt,
  arc=0pt,
  left=1pt,
  right=1pt,
  top=0.5pt,
  bottom=0.5pt,
  boxsep=0pt,
  width=\marginparwidth,
  fontupper=\marginfontsize\raggedright,
  titlerule=0mm
}

% Margin note with category
\renewcommand{\marginnote}[2][Note]{%
  \pkgmarginnote{%
    \inmarginnotetrue
    \begin{marginbox}[#1]{WarmBlue}#2\end{marginbox}%
    \inmarginnotefalse
    \vspace{2pt}%
  }%
}

\newcommand{\marginwarning}[2][Warning]{%
  \pkgmarginnote{%
    \inmarginnotetrue
    \begin{marginbox}[#1]{WarmRose}#2\end{marginbox}%
    \inmarginnotefalse
    \vspace{2pt}%
  }%
}

\newcommand{\margintip}[2][Tip]{%
  \pkgmarginnote{%
    \inmarginnotetrue
    \begin{marginbox}[#1]{WarmGreen}#2\end{marginbox}%
    \inmarginnotefalse
    \vspace{2pt}%
  }%
}

\newcommand{\marginofficial}[1]{%
  \pkgmarginnote{%
    \inmarginnotetrue
    \begin{marginbox}[Official]{WarmPlum}#1\end{marginbox}%
    \inmarginnotefalse
    \vspace{2pt}%
  }%
}

\newcommand{\margincost}[1]{%
  \pkgmarginnote{%
    \inmarginnotetrue
    \begin{marginbox}[Cost]{WarmRose!75!black}#1\end{marginbox}%
    \inmarginnotefalse
    \vspace{2pt}%
  }%
}

\newcommand{\marginenterprise}[1]{%
  \pkgmarginnote{%
    \inmarginnotetrue
    \begin{marginbox}[Enterprise]{WarmBlue!55!black}#1\end{marginbox}%
    \inmarginnotefalse
    \vspace{2pt}%
  }%
}

\newcommand{\margintemplate}[1]{%
  \pkgmarginnote{%
    \inmarginnotetrue
    \begin{marginbox}[Template]{WarmGreen}#1\end{marginbox}%
    \inmarginnotefalse
    \vspace{2pt}%
  }%
}

% --- MAIN TEXT CALLOUT BOXES ---
\tcbset{
  callout-compact/.style={
    breakable,
    enhanced,
    arc=0pt,
    leftrule=3pt,
    rightrule=0pt,
    toprule=0pt,
    bottomrule=0pt,
    left=2pt,
    right=2pt,
    top=1pt,
    bottom=1pt,
    boxsep=0pt,
    toptitle=0.5pt,
    coltitle=DarkText,
    fonttitle=\bfseries
  }
}

\newtcolorbox{notebox}[1][Note]{
  callout-compact,
  colframe=WarmBlue,
  colback=WarmBlue!5,
  title=#1
}

\newtcolorbox{warnbox}[1][Warning]{
  callout-compact,
  colframe=WarmRose,
  colback=WarmRose!5,
  title=#1
}

\newtcolorbox{tipbox}[1][Tip]{
  callout-compact,
  colframe=WarmGreen,
  colback=WarmGreen!5,
  title=#1
}

\newtcolorbox{officialbox}[1][Anthropic Official]{
  callout-compact,
  colframe=WarmPlum,
  colback=WarmPlum!5,
  title=#1
}

% --- PEDAGOGICAL ENVIRONMENTS (v2.0) ---

% Before/After contrast box
\newtcolorbox{beforeafter}[1][Before \& After]{
  callout-compact,
  colframe=WarmBlue,
  colback=WarmBlue!5,
  title=#1
}
\newcommand{\before}{\par\textbf{Before:}\par}
\newcommand{\after}{\par\textbf{After:}\par}

% Try This — practice exercises (<10 min, reader's own project)
\newtcolorbox{trybox}[1][Try This]{
  callout-compact,
  colframe=WarmPlum!55!WarmRose,
  colback=WarmPlum!55!WarmRose!5,
  title=#1
}

% Why Box — reasoning/rationale (answers "why", not "what")
\newtcolorbox{whybox}[1][Why This Matters]{
  callout-compact,
  colframe=WarmGold,
  colback=WarmGold!5,
  title=#1
}

% Key Box — crystallized takeaway (reader should memorize this)
\newtcolorbox{keybox}[1][Key Idea]{
  callout-compact,
  colframe=WarmBlue,
  colback=WarmBlue!5,
  title=#1,
  leftrule=4pt
}

% Decision Box — decision framework (when to choose X over Y)
\newtcolorbox{decisionbox}[1][Decision Framework]{
  callout-compact,
  colframe=WarmGreen!80!black,
  colback=WarmGreen!80!black!5,
  title=#1
}

% Recovery — escape route from anti-pattern (pairs with \antipattern)
\newcommand{\recovery}[3]{%
  \begin{warnbox}[Recovery: #1]
    \textbf{You are here:} #2\par
    \textbf{Escape route:} #3
  \end{warnbox}
}

% Part Introduction — maturity context for each Part
\newtcolorbox{partintro}{
  breakable,
  enhanced,
  colframe=WarmBlue!50,
  colback=WarmBlue!5,
  arc=3pt,
  leftrule=0pt,
  rightrule=0pt,
  toprule=1pt,
  bottomrule=1pt,
  left=6pt,
  right=6pt,
  top=4pt,
  bottom=4pt,
  boxsep=0pt,
  fontupper=\itshape
}

% =============================================================================
% PRACTICE LABEL COMMANDS
% =============================================================================
% Inline labels for tagging practices
\newcommand{\official}[1]{%
  {\color{WarmPlum}\textbf{[Official]}}~#1%
}
\newcommand{\practitioner}[1]{%
  {\color{WarmGreen}\textbf{[Practitioner]}}~#1%
}
\newcommand{\convergence}[1]{%
  {\color{WarmGold}\textbf{[Convergence]}}~#1%
}

% =============================================================================
% TABLES
% =============================================================================
\RequirePackage{booktabs}
\RequirePackage{tabularx}
\RequirePackage{longtable}
\RequirePackage{array}
\RequirePackage{multicol}
\RequirePackage{multirow}
\renewcommand{\arraystretch}{1.2}

% =============================================================================
% MATH
% =============================================================================
\RequirePackage{amsmath,amssymb}

% =============================================================================
% FIGURES AND GRAPHICS
% =============================================================================
\RequirePackage{graphicx}
\RequirePackage{float}
\RequirePackage{caption}
\RequirePackage{tikz}
\usetikzlibrary{
  arrows.meta,
  positioning,
  shapes.geometric,
  shapes.misc,
  fit,
  calc,
  backgrounds,
  decorations.pathreplacing
}

\captionsetup{
  font=small,
  labelfont=bf,
  format=hang,
  margin=6pt,
  skip=4pt,
  singlelinecheck=false
}

% =============================================================================
% LISTS
% =============================================================================
\RequirePackage[shortlabels]{enumitem}

\setlist{
  topsep=0.5pt,
  itemsep=1.5pt,
  parsep=0pt,
  partopsep=0pt,
  leftmargin=*,
  listparindent=0pt
}

\setlist[description]{style=nextline}

% =============================================================================
% CROSS-REFERENCES AND HYPERLINKS
% =============================================================================
\RequirePackage[
  colorlinks=true,
  linkcolor=black,
  urlcolor=WarmBlue,
  citecolor=WarmGreen!80!black,
  pdfusetitle,
  bookmarks=true,
  bookmarksnumbered=true,
  pdfstartview=FitH,
  pdfdisplaydoctitle=true,
  pdfencoding=unicode,
  hyperfootnotes=false
]{hyperref}

\RequirePackage[capitalise,noabbrev]{cleveref}

% Allow URL line breaks at any character (eliminates overfull in URLs)
\expandafter\def\expandafter\UrlBreaks\expandafter{\UrlBreaks
  \do\/\do\-\do\_\do\.\do\=\do\?\do\&\do\#\do\~\do\a\do\b\do\c\do\d
  \do\e\do\f\do\g\do\h\do\i\do\j\do\k\do\l\do\m\do\n\do\o\do\p\do\q
  \do\r\do\s\do\t\do\u\do\v\do\w\do\x\do\y\do\z\do\A\do\B\do\C\do\D
  \do\E\do\F\do\G\do\H\do\I\do\J\do\K\do\L\do\M\do\N\do\O\do\P\do\Q
  \do\R\do\S\do\T\do\U\do\V\do\W\do\X\do\Y\do\Z}

% =============================================================================
% HEADERS (scrlayer-scrpage)
% =============================================================================
\RequirePackage[headsepline]{scrlayer-scrpage}
\pagestyle{scrheadings}
% Guard: scrartcl has no \chapter
\@ifundefined{chapter}{\automark{section}}{\automark[chapter]{chapter}}

\providecommand{\volumeshort}{Claude Best Practices}

\ihead{\footnotesize\volumeshort}
\chead{}
\ohead{\footnotesize\textit{\leftmark}}
\ifoot{} \cfoot{\pagemark} \ofoot{}

% =============================================================================
% HEADING STYLES (KOMA-Script, Tufte italic)
% =============================================================================
\@ifundefined{chapter}{}{\addtokomafont{chapter}{\color{WarmBlue}\itshape}}
\addtokomafont{section}{\color{WarmBlue!90!black}\itshape}
\addtokomafont{subsection}{\color{WarmBlue!80!black}\itshape}

\@ifundefined{chapter}{}{%
  \RedeclareSectionCommand[
    beforeskip=1.0\baselineskip,
    afterskip=0.3\baselineskip
  ]{chapter}%
}

\RedeclareSectionCommand[
  beforeskip=0.6\baselineskip,
  afterskip=0.2\baselineskip
]{section}

\RedeclareSectionCommand[
  beforeskip=0.6\baselineskip,
  afterskip=0.15\baselineskip
]{subsection}

% =============================================================================
% DOCUMENT METADATA
% =============================================================================
\providecommand{\guidetitle}{Best Practices for Using Claude}
\providecommand{\guidesubtitle}{From Personal Mastery to Enterprise Scale}
\providecommand{\guideauthor}{Brandon Behring}
\providecommand{\guideversion}{2.8}
\providecommand{\guidedate}{March 2026}

\AtBeginDocument{%
  \hypersetup{
    pdftitle={\guidetitle},
    pdfauthor={\guideauthor},
    pdfsubject={Claude Code Best Practices},
    pdfkeywords={Claude Code, AI, LLM, best practices, 2026}
  }%
}

% =============================================================================
% COVER PAGE
% =============================================================================
% Cover title color: WarmBlue (default) or WarmRose variant
% To build the rose variant, add \covertitlerose before \makeguidecover
\providecommand{\covertitlecolor}{WarmBlue}
\newcommand{\covertitlerose}{\renewcommand{\covertitlecolor}{WarmRose}}
\newcommand{\makeguidecover}{%
  \begin{titlepage}
    \centering
    \vspace*{2cm}

    {\Huge\bfseries\color{\covertitlecolor}\guidetitle\par}

    \vspace{0.5cm}
    {\Large\guidesubtitle\par}

    \vspace{0.3cm}
    {\normalsize\textit{What Anthropic Recommends, What Practitioners Discover,\\
    and Where They Converge}\par}

    \vspace{2cm}
    {\large\guideauthor\par}

    \vfill

    {\normalsize Version \guideversion\par}
    {\normalsize\guidedate\par}

    \vspace{0.5cm}
    {\footnotesize Content verified against Anthropic documentation as of \guidedate.\par}
    {\footnotesize Licensed under CC~BY~4.0\par}
  \end{titlepage}
}

% =============================================================================
% CONVENIENCE COMMANDS
% =============================================================================

% Key insight callout
\newcommand{\keyinsight}[1]{%
  \begin{notebox}[Key Insight]
    #1
  \end{notebox}
}

% Anti-pattern callout
\newcommand{\antipattern}[3]{%
  \begin{warnbox}[Anti-Pattern: #1]
    \textbf{Symptom:} #2\par
    \textbf{Prevention:} #3
  \end{warnbox}
}

% Maturity level indicator
\newcommand{\maturitylevel}[1]{%
  {\color{WarmBlue}\textbf{L#1}}%
}

% Source footnote (for Anthropic URLs)
% In margins: renders as tiny inline URL (footnotes fail inside hboxes)
% In body text: normal footnote
\newcommand{\sourceurl}[1]{%
  \ifinmarginnote
    \\[-2pt]{\tiny\raggedright\url{#1}\par}%
  \else
    \footnote{\url{#1}}%
  \fi
}

% =============================================================================
% END OF STYLE
% =============================================================================
\endinput
