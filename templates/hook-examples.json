{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/lint-on-write.sh",
            "description": "Auto-lint written files with ruff"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python -m pytest --cov=src --cov-report=term-missing tests/ 2>/dev/null | tail -5",
            "description": "Report test coverage after shell commands"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/pre-commit-gate.sh",
            "description": "Block git commits if tests fail or type errors exist"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo \"Task completed at $(date)\" >> .claude/session.log",
            "description": "Log task completion timestamp"
          }
        ]
      }
    ]
  }
}
