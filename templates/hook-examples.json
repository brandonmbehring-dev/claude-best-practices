{
  "hooks": {
    "PostFileWrite": [
      {
        "type": "command",
        "command": "ruff check --fix \"$FILE\"",
        "description": "Auto-lint written files with ruff"
      }
    ],
    "PreCommit": [
      {
        "type": "command",
        "command": "pytest tests/ && mypy src/",
        "description": "Block commits if tests fail or type errors exist"
      }
    ],
    "PostCommit": [
      {
        "type": "command",
        "command": "python -m pytest --cov=src --cov-report=term-missing tests/ 2>/dev/null | tail -5",
        "description": "Report test coverage change after each commit"
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "echo \"Task completed at $(date)\" >> .claude/session.log",
        "description": "Log task completion timestamp"
      }
    ]
  }
}
